# ============================================
# AIPICSQR Photographer Node - Configuration
# ============================================
# Copy this file to .env. The node can start with these defaults,
# and you only need to set PHOTOGRAPHER_ID and EVENT_ID after web login.

# â”€â”€ Supabase â”€â”€
SUPABASE_URL=https://leaqxwekdwtgmnausohn.supabase.co
SUPABASE_ANON_KEY=sb_publishable_5SZwgXs_F_gSJ9acaEF3ow_kH-bhDPb



# â”€â”€ Identity â”€â”€
# Your photographer ID from the dashboard
PHOTOGRAPHER_ID=your_photographer_uuid_from_dashboard
# Current active event ID
EVENT_ID=your_event_uuid

# â”€â”€ API â”€â”€
API_BASE_URL=https://aipicsqr.vercel.app

# â”€â”€ Folders to Watch â”€â”€
# Comma-separated list of folder paths where photos will be dropped
SCAN_FOLDERS=C:\Photos\EventPhotos

# â”€â”€ Image Compression â”€â”€
TARGET_SIZE_MB=1.5
JPEG_QUALITY_START=85
JPEG_QUALITY_MIN=40
MAX_DIMENSION=3840

# â”€â”€ Face Recognition â”€â”€
FACE_CONFIDENCE=0.7

# â”€â”€ Resource Limits â”€â”€
MAX_CPU_PERCENT=90
MAX_CPU_TEMP=85.0
COOLDOWN_PERIOD=30

# â”€â”€ Telemetry â”€â”€
PULSE_INTERVAL=60
# Node ID is auto-assigned on first registration. Leave empty initially.
NODE_ID=
